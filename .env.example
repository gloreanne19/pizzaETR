# ==============================================================================
# PAQUITO'S PIZZA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development, or configure these in
# your production hosting platform (e.g. Vercel, Railway, Render, DigitalOcean, VPS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' on your live server, or 'development' locally
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Canonical URL of the application (include https:// in production)
# E.g. Development: http://localhost:3000
# E.g. Production:  https://paquitospizza.com (or https://your-app.vercel.app)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Development: Localhost / Docker MySQL
# Production:  Aiven, PlanetScale, AWS RDS, Railway MySQL, or cPanel MySQL
DB_HOST=127.0.0.1
DB_NAME=pizza_pizza
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_PORT=3306

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a strong, random 64-character string for production:
# (You can run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=super_secret_jwt_key_replace_with_64_character_random_string

# Cookie session names
JWT_USER_COOKIE=pizza_user_token
JWT_ADMIN_COOKIE=pizza_admin_token

# Token expiration duration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (SMTP / Gmail)
# ------------------------------------------------------------------------------
# For Gmail, use an "App Password" (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_business_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
EMAIL_FROM_NAME="Paquito's Pizza Orders"

# ------------------------------------------------------------------------------
# 5. CLOUDINARY PRODUCTION IMAGE HOSTING & CDN
# ------------------------------------------------------------------------------
# 1. Sign up for a free account at https://cloudinary.com (Includes 25GB bandwidth)
# 2. Get your Cloud Name, API Key, and API Secret from your Cloudinary Dashboard:
#    https://console.cloudinary.com/
# 3. Once filled, run `npm run seed:cloudinary` to upload all product assets & migrate DB.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=

